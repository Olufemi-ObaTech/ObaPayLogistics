# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL="postgresql://obapay:obapay_pw@localhost:5432/obapay?schema=public"

# --- Redis (caching, idempotency keys, real-time tracking cache) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"
TOTP_ISSUER="ObaPay"

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Logistics: courier partner credentials (stubbed in MVP) ---
DHL_API_BASE="http://localhost:4001/dhl"
DHL_API_KEY="stub-dhl-key"
ARAMEX_API_BASE="http://localhost:4001/aramex"
ARAMEX_API_KEY="stub-aramex-key"
SENDY_API_BASE="http://localhost:4001/sendy"
SENDY_API_KEY="stub-sendy-key"

# --- Logistics: pricing/margin config ---
LOGISTICS_MARGIN_PCT=8
CUSTOMS_AUTO_CLEAR_MIN_DELAY_MS=60000
CUSTOMS_AUTO_CLEAR_MAX_DELAY_MS=300000

# --- Geocoding stub ---
GEOCODING_API_BASE="http://localhost:4001/geocode"

# --- Customs document storage: uploads must resolve to this trusted prefix ---
DOCUMENT_STORAGE_BASE_URL="https://storage.obapay.com/"

# --- CORS: comma-separated allowed origins (no wildcard fallback in production) ---
CORS_ORIGIN="http://localhost:3001"

# --- FX ---
FX_BASE_CURRENCY="USD"
FX_SPREAD_PCT=0.5
MERCHANT_SETTLEMENT_FEE_PCT=1.5
